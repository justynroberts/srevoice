# Copy to .env for local docker compose. On Coolify, set these as env vars instead.

# Seals the settings file at rest. Required in production.
# Generate: openssl rand -base64 32
SREVOICE_MASTER_KEY=

# Gates every /api route behind an x-srevoice-token header. Leave blank only on
# a machine nobody else can reach.
# Generate: openssl rand -hex 24
SREVOICE_ACCESS_TOKEN=

# Optional
LOG_LEVEL=info
PORT=5280
DATA_DIR=/data

# Note: the ElevenLabs API key and the PagerDuty MCP tokens are NOT set here.
# They are pasted into the Settings panel and encrypted with SREVOICE_MASTER_KEY.
